{
    email dallianltd@gmail.com
}

dallian.online, www.dallian.online {
    encode zstd gzip

    # Healthcheck
    handle /healthz* {
        reverse_proxy backend:8000
    }

    # Django API endpoints
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Django Admin
    handle /wakuu/* {
        reverse_proxy backend:8000
    }

    # Static files served by Django
    handle /static/* {
        reverse_proxy backend:8000
    }

    # Media uploads
    handle /media/* {
        reverse_proxy backend:8000
    }

    # Everything else goes to Next.js Frontend
    handle {
        reverse_proxy frontend:3000
    }
}
